{
  "name": "micro-grant-dao-simulation",
  "version": "1.0.0",
  "private": true,
  "description": "A local full-stack micro-grant DAO simulation demonstrating governance, lifecycle transitions, auditing, and blockchain-inspired event modeling without real blockchain infrastructure.",
  "keywords": [
    "dao",
    "blockchain-simulation",
    "governance",
    "grant-management",
    "auditability",
    "full-stack",
    "typescript",
    "sqlite"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx backend/src/server.ts",
    "lint": "eslint backend/src backend/test",
    "start": "node dist/backend/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "eslint": "^9.35.0",
    "tsx": "^4.19.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
